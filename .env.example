# BillionBiz Frontend Environment Template (.env.example)
# Copy to .env.local for local development or set in Vercel Project Settings

# Primary API Base URL
# For local development with tunnel: https://<your-ngrok-subdomain>.ngrok-free.app/api/v1
# For direct localhost: http://localhost:8080/api/v1
# For production: https://api.chandraprakash.codes/api/v1
VITE_API_BASE_URL=https://api.chandraprakash.codes/api/v1
VITE_API_URL=https://api.chandraprakash.codes/api/v1

# Realtime WebSocket Gateway
VITE_WS_BASE_URL=wss://api.chandraprakash.codes/realtime

# Subdomain Routing Configuration
VITE_PUBLIC_DOMAIN=chandraprakash.codes
VITE_PUBLIC_ROOT_URL=https://chandraprakash.codes
VITE_PUBLIC_ADMIN_URL=https://admin.chandraprakash.codes
VITE_PUBLIC_ACCOUNTS_URL=https://accounts.chandraprakash.codes
VITE_PUBLIC_STAFF_URL=https://staff.chandraprakash.codes
VITE_PUBLIC_POS_URL=https://pos.chandraprakash.codes
VITE_PUBLIC_OPS_URL=https://ops.chandraprakash.codes

