# BillionBiz Frontend Environment Template
# Copy to .env.local for local development or configure in Vercel Project Settings

# Main Website (Public Landing & Marketing)
VITE_MAIN_WEBSITE_URL=https://www.chandraprakash.codes

# Dedicated Application URLs
VITE_ADMIN_URL=https://admin.chandraprakash.codes
VITE_ACCOUNTS_URL=https://accounts.chandraprakash.codes
VITE_STAFF_URL=https://staff.chandraprakash.codes
VITE_POS_URL=https://pos.chandraprakash.codes
VITE_OPS_URL=https://ops.chandraprakash.codes

# Backend API Endpoints
VITE_API_URL=https://api.chandraprakash.codes/api/v1
VITE_API_BASE_URL=https://api.chandraprakash.codes/api/v1

# Domain Architecture
VITE_ROOT_DOMAIN=chandraprakash.codes
VITE_PUBLIC_DOMAIN=chandraprakash.codes
VITE_STORE_DOMAIN_PATTERN=*.chandraprakash.codes
VITE_DEFAULT_STORE_DOMAIN=chandraprakash.codes

# Google Identity (Public Client ID only - never put client secret in frontend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
